{
  "expo": {
    "name": "GOK-NET",
    "slug": "gok-net",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gokulesh-logo.png",
    "scheme": "gok-net",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/splash-logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F7F5F0",
            "image": "./assets/splash-logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/gokulesh-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
