# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://eqofdedstkagqkfnksac.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # safe to expose — RLS protects the data
SUPABASE_SERVICE_ROLE_KEY=                # NEVER expose client-side; bypasses RLS

# ─── Operator / Dev access ───────────────────────────────────────────────────
# generate with: openssl rand -hex 32
OPERATOR_SECRET=

# ─── PostHog ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Sentry ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=gok-net-web
SENTRY_AUTH_TOKEN=                        # source map upload only; CI/build only

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development           # development | staging | production

# ─── Support email (Help & support sidebar form) ────────────────────────────
# Sends to hello@credenceinnovations.co via Resend — https://resend.com/api-keys
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=                       # must be a Resend-verified sender; falls back to onboarding@resend.dev
